# Copy to .env, edit, then run: python src/main.py --env-file .env
PUBLICATIONS_FILE=publications.txt
SITE_DIR=site
STATE_DIR=.state
SITE_URL=http://localhost:8000
EPISODE_MODE=summary
# Maximum minutes per audio file. Full articles become multiple parts.
# Set 0 for unlimited length; summaries still respect MAX_SCRIPT_WORDS.
MAX_EPISODE_MINUTES=5
MAX_SCRIPT_WORDS=700
MIN_WORDS=1500
MAX_EPISODES_PER_RUN=20
KEEP_EPISODES=0
LOOKBACK_HOURS=36
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=+0%
SUMMARY_MODEL=gemini-flash-latest
GEMINI_API_KEY=
# Needed only for public Pages publishing; generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STATE_ENCRYPTION_KEY=
PUBLISH_TO_PAGES=false
# Optional login cookie, sent ONLY to exact hosts explicitly listed below.
SUBSTACK_SID=
SUBSTACK_AUTH_HOSTS=
FEED_TITLE=My Newsletter Podcast
# Source titles/URLs and error details appear in logs only when explicitly enabled.
VERBOSE=false
